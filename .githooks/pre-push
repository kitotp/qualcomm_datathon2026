#!/bin/sh
# Block direct pushes to main. Changes reach main only through reviewed pull requests.
# Turn on with: git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked." >&2
    echo "Push a feature branch and open a pull request instead." >&2
    exit 1
  fi
done

exit 0
